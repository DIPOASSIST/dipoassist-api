generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  password String
  name String
  role String @default("user")  
  phone_number String
  image_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  phrasesUrgency PhraseUrgency[] @relation("PhraseUrgency")

  @@map("users")
}

model Phrase {
  id String @id @default(cuid())
  text String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("phrases")
}

model PhraseUrgency {
  id String @id @default(cuid())
  user_id String
  phrase_id String
  is_urgent Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user User @relation("PhraseUrgency",fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("phrases_urgency")
}