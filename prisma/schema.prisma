// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NAKES
  USER
}

model User {
  id String    @id @default(cuid())
  email String    @unique
  username String    @unique
  password String
  name String
  role Role @default(USER)  // admin | nakes | user
  phone_number String
  image_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  nakes_id String?
  nakes User? @relation("NakesPatients", fields: [nakes_id], references: [id])
  patients User[] @relation("NakesPatients")

  phrasesUrgency PhraseUrgency[] @relation("PhraseUrgency")
  predict Predict[] @relation("Predict")

  @@map("users")
}


model Phrase {
  id String @id @default(cuid())
  text String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("phrases")
}

model PhraseUrgency {
  id String @id @default(cuid())
  user_id String
  phrase_id String
  is_urgent Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user User @relation("PhraseUrgency",fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("phrases_urgency")
}

model Device{
  id String @id @default(cuid())
  user_id String
  medical_id String
  name String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("devices")
}

model Predict {
  id String @id @default(cuid())
  user_id String
  emg_signal String
  predict_phrase String
  creted_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user User @relation("Predict", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("predicts")
}

model ArticleType {
  id String @id @default(cuid())
  name String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  article Article[] @relation("ArticleType")

  @@map("article_types")
}

model Article {
  id String @id @default(cuid())
  title String
  content String
  type_id String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  articleType ArticleType @relation("ArticleType", fields: [type_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("articles")
}