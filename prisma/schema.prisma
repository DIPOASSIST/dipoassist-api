// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NAKES
  USER
}

model User {
  id String    @id @default(cuid())
  email String    @unique
  username String    @unique
  password String
  name String
  role Role @default(USER)  // admin | nakes | user
  phone_number String
  image_url String?
  fcm_token String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  nakes_id String?
  nakes User? @relation("NakesPatients", fields: [nakes_id], references: [id])
  patients User[] @relation("NakesPatients")

  phrasesUrgency PhraseUrgency[] @relation("PhraseUrgency")
  predict Predict[] @relation("Predict")
  reports Report[] @relation("Report")
  devicesPatient Device[] @relation("PatientDevices")
  devicesNakes Device[] @relation("MedicalDevices")
  schedulesPatient Schedule[] @relation("PatientSchedules")
  schedulesNakes Schedule[] @relation("MedicalSchedules")
  histories History[] @relation("History")

  @@map("users")
}

model Phrase {
  id         String          @id @default(cuid())
  text       String
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  urgencies  PhraseUrgency[] @relation("PhraseToUrgency")

  @@map("phrases")
}

model PhraseUrgency {
  id         String   @id @default(cuid())
  user_id    String
  phrase_id  String
  is_urgent  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User    @relation("PhraseUrgency", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  phrase Phrase  @relation("PhraseToUrgency", fields: [phrase_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("phrases_urgency")
}

model Device{
  id String @id @default(cuid())
  user_id String
  medical_id String
  device_token String @unique
  name String
  is_online Boolean @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient User @relation("PatientDevices", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nakes   User @relation("MedicalDevices", fields: [medical_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  logs DeviceLog[] @relation("DeviceLogs")

  @@map("devices")
}

model DeviceLog{
  id String @id @default(cuid())
  device_id String
  message String
  created_at DateTime @default(now())
  device Device @relation("DeviceLogs", fields: [device_id], references: [id], onDelete: Cascade)

  @@map("device_logs")
}

model Predict {
  id String @id @default(cuid())
  user_id String
  emg_signal String
  predict_phrase String
  creted_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user User @relation("Predict", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("predicts")
}

model History{
  id String @id @default(cuid())
  user_id String
  predicted_label String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user User @relation("History", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Report{
  id String @id @default(cuid())
  user_id String
  title String
  content String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user User @relation("Report", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("reports")
}

model Schedule{
  id String @id @default(cuid())
  medical_id String
  patient_id String
  title String
  notes String?
  schedule_date DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient User @relation("PatientSchedules", fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nakes   User @relation("MedicalSchedules", fields: [medical_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}